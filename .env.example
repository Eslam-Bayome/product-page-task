# EasyOrders public API + exchange rates (prices are USD; EGP is converted live)
VITE_API_URL=https://api.easy-orders.net
VITE_STORE_SLUG=clear-theme
VITE_PRODUCT_SLUG=Sneakers12
VITE_RATES_API_URL=https://open.er-api.com

# Analytics: console (default in dev) | mixpanel | off (default in builds).
# mixpanel needs the project token; never commit a production token.
VITE_ANALYTICS_MODE=
VITE_MIXPANEL_TOKEN=
